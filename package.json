{
  "name": "dsh-locale-ru",
  "version": "1.0.0",
  "description": "Russian localization (ru) for the DeepSeek Harness web GUI — a language pack for @deepseek-ai/dsh-client-locale.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "locale",
    "localization",
    "i18n",
    "russian",
    "ru"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vowa-antilamer/dsh-locale-ru.git"
  },
  "homepage": "https://github.com/vowa-antilamer/dsh-locale-ru#readme",
  "bugs": {
    "url": "https://github.com/vowa-antilamer/dsh-locale-ru/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
